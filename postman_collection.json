        {
          "name": "5. Execute Intent (Create PayPal Order & Ledger Hold)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.paypal_order_id) { pm.collectionVariables.set('paypalOrderId', jsonData.paypal_order_id); }",
                  "pm.test('PayPal order created or approved', function () {",
                  "    pm.expect(jsonData.approval_url || jsonData.paypal_order_id).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"return_url\": \"http://localhost:5173/?paypal_return=true&intent_id={{intentId}}\",\n  \"cancel_url\": \"http://localhost:5173/?paypal_cancel=true&intent_id={{intentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/intents/{{intentId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "intents",
                "{{intentId}}",
                "execute"
              ]
            },
            "description": "Places atomic ledger hold on source envelope and calls PayPal Orders v2 to generate approval URL."
