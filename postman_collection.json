    {
      "name": "4. Intent Gateway (Proactive Firewall)",
      "item": [
        {
          "name": "1. Submit Intent (Allowed Groceries $24.00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('intentId', jsonData.id); }",
                  "pm.test('Status is accepted', function () { pm.expect(jsonData.verdict).to.eql('accepted'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-test-intent-groceries-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"utterance\": \"Buying fresh groceries at Trader Joe's\",\n  \"amount\": 2400,\n  \"currency\": \"USD\",\n  \"merchant_name\": \"Trader Joe's\",\n  \"short_tag\": \"groceries\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "intents"
              ]
            },
            "description": "Evaluates purchase utterance against Daily Living envelope. Returns verdict, balance preview, and sets {{intentId}}."
