    {
      "name": "Intent Gateway (Proactive Firewall)",
      "item": [
        {
          "name": "1. Submit Allowed Intent (Groceries $24.00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('intentId', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "pm-test-intent-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"utterance\": \"Buying groceries at Trader Joe's\",\n  \"amount\": 2400,\n  \"currency\": \"USD\",\n  \"merchant_name\": \"Trader Joe's\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/intents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "intents"]
            }
          }
        },
